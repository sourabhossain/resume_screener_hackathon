# Database (MySQL)
DB_NAME=resume_db
DB_USER=resume_user
DB_PASSWORD=your_password_here
DB_ROOT_PASSWORD=your_root_password_here
DB_HOST=db
DB_PORT=3306

# Django
DEBUG=True
SECRET_KEY=change-this-to-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Email settings
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=[MAILBOX@sslwireless.com]
EMAIL_HOST_PASSWORD=[MAILBOX_PASSWORD]
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SSL Wireless Careers <[MAILBOX@sslwireless.com]>

# Site base URL
SITE_BASE_URL=http://localhost:8000

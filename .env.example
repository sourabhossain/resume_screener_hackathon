# Database (MySQL)
DB_NAME=resume_db
DB_USER=resume_user
DB_PASSWORD=your_password_here
DB_ROOT_PASSWORD=your_root_password_here
DB_HOST=db
DB_PORT=3306

# Django
DEBUG=True
SECRET_KEY=change-this-to-a-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Redis / Celery
# In production set a strong password; the prod compose passes it to redis-server
# (--requirepass) and into the broker/cache URLs. Use a long random value here.
REDIS_PASSWORD=[PLACEHOLDER_STRONG_REDIS_PASSWORD]
CELERY_BROKER_URL=redis://:[PLACEHOLDER_STRONG_REDIS_PASSWORD]@redis:6379/0
